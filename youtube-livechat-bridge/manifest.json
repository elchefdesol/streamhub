{
  "manifest_version": 3,
  "name": "StreamHub YouTube Livechat Bridge",
  "version": "0.1.0",
  "description": "Captures YouTube live chat messages and sends them to local StreamHub.",
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://studio.youtube.com/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/live_chat*",
        "https://www.youtube.com/live_chat_replay*",
        "https://www.youtube.com/watch*",
        "https://studio.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "StreamHub YouTube Bridge"
  }
}
